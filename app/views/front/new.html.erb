<div class="container animated fadeIn" style="opacity: 0.8">
  <div class = "card-detail" style = "background-color: black; width: 100%;"><br/>
    <h1 class= "text-center" style="color: white;">Request Software Record</h1>
    <p style="font-size: 12px; float: right; margin-right: 30px; margin-bottom: 0px !important"><b style="color: red; font-size: 20px">*</b> indicates a required field</p><br>
    <hr style="background-color: white">
    <div class = "card-body">
        <%= form_for(SoftwareRecord.new) do |form| %>
          
          <div class="mb-3">
            <%= form.label :title %><b style="color: red; font-size: 20px"> *</b>
            <%= form.text_field :title, :class => "form-control" %>
          </div>
          
          <div class="mb-3">
            <%= form.label :description %><b style="color: red; font-size: 20px"> *</b>
            <%= form.text_area :description, :cols => 30, :rows => 7, :class => "form-control" %>
          </div>
          
          <div class="mb-3">
            <%= form.label "Status" %><b style="color: red; font-size: 20px"> *</b>
            <%= form.collection_select(:status_id, Status.where(title: 'Requested'), :id, :title, {}, {:class => "form-control"}) %>
          </div>

          <% if user_signed_in? && current_user.role.to_s == "owner" %>
            <div class="mb-3">
              <%= form.label :date_implemented %>
              <%= form.date_field :date_implemented, class: "form-control" %>
            </div>
          <% end %>

          <% if user_signed_in? && current_user.role.to_s == "owner" %>
            <div class="mb-3">
              <%= form.label :date_of_upgrade %>
              <%= form.date_field :date_of_upgrade, class: "form-control" %>
            </div>
          <% end %>

          <div class="mb-3">
            <%= form.label "Request By" %><b style="color: red; font-size: 20px"> *</b>
            <% if user_signed_in? %>
              <%= form.text_field :created_by, class: "form-control regex-createdby", value: current_user.first_name+" "+current_user.last_name, data: { controller: "input-sanitization", action: "input->input-sanitization#sanitize" } %>
            <% else %>
              <%= form.text_field :created_by, class: "form-control regex-createdby", placeholder: "FirstName LastName", data: { controller: "input-sanitization", action: "input->input-sanitization#sanitize" } %>
            <% end %>
          </div>

          <div class="mb-3">
            <%= form.label "Software Type" %><b style="color: red; font-size: 20px"> *</b>
            <%= form.collection_select(:software_type_id, SoftwareType.order(:title), :id, :title, {}, {:class => "form-control"}) %>
          </div>
          
          <div class="mb-3" style="display: none">
            <%= form.label "Vendor" %><b style="color: red; font-size: 20px"> *</b>
            <select class="form-control" name="software_record[vendor_record_id]" id="software_record_vendor_record_id">
              <option value=1>University of Cincinnati</option>
            </select>
          </div>

          <%# Same multi-value contract as _form_multi_*.html.erb (no role branching on qa). %>
          <div class="mb-3" id="multiple_departments" data-controller="multi-value-inputs" data-multi-value-inputs-field-name-value="departments">
            <div class="d-flex align-items-center gap-2">
              <%= form.label :departments, "Departments", for: "software_record_departments_1", class: "form-label mb-0" %>
              <button type="button" class="btn btn-sm btn-outline-primary js-add-multivalue" data-action="click->multi-value-inputs#add">+ add more</button>
            </div>
            <div class="input-group mt-2" data-multivalue-row>
              <%= text_field_tag "software_record[departments][]", nil, required: true, class: "form-control", id: "software_record_departments_1" %>
              <button type="button" class="btn btn-outline-danger js-remove-multivalue" data-action="click->multi-value-inputs#remove">Delete</button>
            </div>
          </div>

          <div class="mb-3" id="multiple_product_owners" data-controller="multi-value-inputs" data-multi-value-inputs-field-name-value="product_owners">
            <div class="d-flex align-items-center gap-2">
              <%= form.label :product_owners, "Primary Contact", for: "software_record_product_owners_1", class: "form-label mb-0" %>
              <button type="button" class="btn btn-sm btn-outline-primary js-add-multivalue" data-action="click->multi-value-inputs#add">+ add more</button>
            </div>
            <div class="input-group mt-2" data-multivalue-row>
              <%= text_field_tag "software_record[product_owners][]", nil, required: true, class: "form-control", id: "software_record_product_owners_1" %>
              <button type="button" class="btn btn-outline-danger js-remove-multivalue" data-action="click->multi-value-inputs#remove">Delete</button>
            </div>
          </div>

          <div class="mb-3" id="multiple_admin_users" data-controller="multi-value-inputs" data-multi-value-inputs-field-name-value="admin_users">
            <div class="d-flex align-items-center gap-2">
              <%= form.label :admin_users, "Primary Contact", for: "software_record_admin_users_1", class: "form-label mb-0" %>
              <button type="button" class="btn btn-sm btn-outline-primary js-add-multivalue" data-action="click->multi-value-inputs#add">+ add more</button>
            </div>
            <div class="input-group mt-2" data-multivalue-row>
              <%= text_field_tag "software_record[admin_users][]", nil, required: true, class: "form-control", id: "software_record_admin_users_1" %>
              <button type="button" class="btn btn-outline-danger js-remove-multivalue" data-action="click->multi-value-inputs#remove">Delete</button>
            </div>
          </div>


          <% if user_signed_in? && current_user.role.to_s == "owner" %>
            <div class="mb-3">
              <%= form.label :production_url %>
              <%= form.text_field :production_url, :class => "form-control" %>
            </div>
          <% end %>

          <% if user_signed_in? && current_user.role.to_s == "owner" %>
            <div class="mb-3">
              <%= form.label :user_seats %>
              <%= form.text_field :user_seats, :class => "form-control" %>
            </div>
          <% end %>

          <% if user_signed_in? && current_user.role.to_s == "owner" %>
            <div class="mb-3">
              <%= form.label :annual_fees %>
              <%= form.text_field :annual_fees, :class => "form-control" %>
            </div>
          <% end %>

          <% if user_signed_in? && current_user.role.to_s == "owner" %>
            <div class="mb-3">
              <%= form.label :support_contract %><br/>
              <%= form.label :support_contract, "Yes", :value => "Yes"  %>
              <%= form.radio_button :support_contract, "Yes" %>
              <%= form.label :support_contract, "No", :value => "No" %>
              <%= form.radio_button :support_contract, "No", :checked => true %>
            </div>
          <% end %>

          <% if user_signed_in? && current_user.role.to_s == "owner" %>
            <div class="mb-3">
              <%= form.label :hosting_environment %>
              <%= form.text_field :hosting_environment, :class => "form-control" %>
            </div>
          <% end %>

          <% if user_signed_in? && current_user.role.to_s == "owner" %>
            <div class="mb-3">
              <%= form.label :current_version %>
              <%= form.text_field :current_version, :class => "form-control" %>
            </div>
          <% end %>

          <div class="mb-3">
            <%= form.label :notes %>
            <%= form.text_area :notes, :cols => 30, :rows => 7, :class => "form-control" %>
          </div>

          <% if user_signed_in? && current_user.role.to_s == "owner" %>
            <div class="mb-3">
              <%= form.label :business_value %>
              <%= form.text_field :business_value, :class => "form-control" %>
            </div>
          <% end %>
        <br/>
        
        <div class="captcha" style="width: 30%; margin: 0 auto;">
          <%= recaptcha_tags %>
        </div>
        
        <br/>
        <div class="mb-3" style= "text-align: center;">
          <%= form.submit nil, class: "btn btn-primary" %>
          <%= link_to 'Cancel', session[:previous], :class => "btn btn-danger" %>
        </div>
      <% end %>
    </div>
  </div>
  <br/>
  <br/>
  <br/>
</div>
