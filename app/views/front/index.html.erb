<div class="view" style="background-image: url('https://user-images.githubusercontent.com/5084562/73669639-c8ab2a00-4675-11ea-90bf-c9ba1766952f.png'); background-repeat: repeat; background-size: cover; background-position: center center;">
<div class="container animated pulse" style="display:flex; justify-content: center; align-items: center; height: 92vh; opacity: 0.9;">
  <div class="card border-0 bg-transparent p-5 text-center" style="width: 80%;"><br/>
    <h1 style="color: white;">Welcome to UCL Application Portfolio !</h1><br/>
    <em style="color: white; font-size: 17px">An inventory of all applications in UC Libraries (current, in progress, legacy)</em><br/>
    <hr style="background-color: white">
    <p class="lead">
        <% if current_user %>
            <p style="color: white">Logged in as <%= current_user.email %></p>
            <%= logout_link "Logout", destroy_user_session_path, class: "btn btn-dark btn-lg action-btn mx-auto" %>
        <% else %>
            <%= link_to "Login", (Rails.configuration.x.auth.shibboleth_enabled ? shibboleth_force_authn_login_path : new_user_session_path), {:class => "btn btn-dark btn-lg mx-auto action-btn"} %>
        <% end %>
    </p>
</div>
</div>
<div class="footer" style="background-color: transparent; color: #BDBDBD; padding-bottom: 10px;">
  <div class="container">
    <p style="font-size: 13px; text-align: center; color: white;">All Rights Reserved &reg; 2019 | <a href="https://www.uc.edu" target="_blank">University of Cincinnati</a> &copy;.</p>
  </div>
</div>
</div>