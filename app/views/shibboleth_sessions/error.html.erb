<div class="container animated fadeIn" style="display:flex; justify-content: center; align-items: center; min-height: 70vh;">
  <div class="card" style="max-width: 760px; width: 100%; border-top: 5px solid #b00000;">
    <div class="card-body">
      <h2 style="color: #7a0018; margin-bottom: 16px;">Shibboleth Login Troubleshooting</h2>
      <p style="font-size: 1.1rem; margin-bottom: 8px;">We could not complete account creation from your Shibboleth identity.</p>
      <p style="margin-bottom: 18px;"><strong>Error:</strong> <%= @error_message %></p>
      <p style="margin-bottom: 0;">
        Please share this message with the application team so they can update your account configuration.
      </p>
    </div>
  </div>
</div>
