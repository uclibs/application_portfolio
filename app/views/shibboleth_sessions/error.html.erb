<div class="container animated fadeIn" style="display:flex; justify-content: center; align-items: center; min-height: 70vh;">
  <div class="card" style="max-width: 760px; width: 100%; border-top: 5px solid #b00000;">
    <div class="card-body">
      <h2 style="color: #7a0018; margin-bottom: 16px;">Unable to complete sign-in</h2>
      <p style="font-size: 1.1rem; margin-bottom: 8px;">
        We couldn't finish setting up your account using campus authentication.
      </p>
      <% if @validation_error_detail.present? %>
        <p style="margin-bottom: 18px;"><strong>Details (for troubleshooting):</strong> <%= @validation_error_detail %></p>
      <% end %>
      <p style="margin-bottom: 0;">
        If this continues, please contact the Application Portfolio team with the time you tried to sign in.
      </p>
    </div>
  </div>
</div>
