<div class="navbar sticky-top" style="height: 70px;">
  <div class="container d-flex align-items-center" style="max-width: 4000px">
    <a class="masthead-brand" href="https://www.uc.edu/" target="_blank"><%= image_tag("UC_Logo.svg", top: '0', width: '113px', height: '49px') %></a>
    <nav class="nav nav-masthead align-items-center flex-nowrap ms-auto">
      <% if user_signed_in? %>
        <%= form_tag(search_path, method: :get, class: 'header-search-form') do %>
          <div class="input-group input-group-sm header-search-group">
            <%= search_field_tag :search, params[:search], placeholder: 'Search..', class: 'form-control', 'aria-label': 'Search' %>
            <button type="submit" class="btn btn-danger header-search-btn" aria-label="Submit search">
              <i class="fa fa-search fa-xs"></i>
            </button>
          </div>
        <% end %>
      <% end %>
      <%= nav_helper 'nav-link' %>
      <% if user_signed_in? %>
        <div class="dropdown ms-3">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <%= user_display_name %>
          </a>
          <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
            <li><%= link_to 'My Profile', myprofile_path, class: 'dropdown-item' %></li>
            <li><%= logout_link 'Logout', destroy_user_session_path, class: 'dropdown-item' %></li>
          </ul>
        </div>
      <% end %>
    </nav>
  </div>
</div>
