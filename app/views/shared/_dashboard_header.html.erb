<div class="navbar sticky-top" style="height: 70px;">
  <div class="container" style="max-width: 4000px">
    <a class="masthead-brand" href="https://www.uc.edu/" target="_blank"><%= image_tag("UC_Logo.svg", top:'0', width:'113px', height: '49px')%></a>
    <nav class="nav nav-masthead">
      <% if user_signed_in? %>
        <%= form_tag(search_path, :method => "get", class: "mt-1") do %>  

          <div class="input-group" style="width: fit-content;">
  <%= search_field_tag :search, params[:search], placeholder: "Search..", class: "form-control rounded-start", style: "height: 27px;" %>

  <button type="submit" class="btn search-btn d-flex align-items-center justify-content-center rounded-end ms-2" style="height: 27px; width: 36px; background-color: #E00122; color: white; padding: 
0;">
    <i class="fa fa-search fa-xs" style="font-size: 14px;"></i>
  </button>
</div>


        <% end %>
      <% end %>
      <p class="ms-3"></p>
       <%= nav_helper 'nav-link' %>
       <% if user_signed_in? %>
         <div class="dropdown ms-3">
           <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
             <%= [current_user.first_name, current_user.last_name].compact_blank.join(' ') %>
           </a>
           <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
             <li><%= link_to 'My Profile', myprofile_path, class: 'dropdown-item' %></li>
             <li><%= logout_link 'Logout', destroy_user_session_path, class: 'dropdown-item' %></li>
           </ul>
         </div>
       <% end %>
    </nav>
  </div>
</div>
