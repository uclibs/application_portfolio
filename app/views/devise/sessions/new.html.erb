<div class="container animated fadeIn" style="display:flex; justify-content: center; align-items: center; height: 85vh; opacity: 0.9">
  <div class = "card" style = "background-color: black; width: 36%;"><br/>
    <h2 class= "text-center" style="color: white; padding-top: 14px">Login</h2><hr style="background: white">
      <div class = "card-body">
      <% if Rails.configuration.x.auth.shibboleth_enabled %>
        <p style="color: white; text-align: center;">Use University SSO to continue.</p>
        <div class="actions" style="text-align: center">
          <%= link_to 'Sign in with University SSO', shibboleth_force_authn_login_path, class: 'btn btn-dark btn-lg mx-auto action-btn' %>
        </div>
      <% else %>
        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="input-group mb-3" style="width: 90%; margin: auto;">
             <span class="input-group-text">
             <%= image_tag("login.png", width: '18px', height: '19px') %>
             </span>
             <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control email-input", placeholder: "Email" %>
          </div>
          <div class="actions" style="text-align: center">
            <button type="submit" name="commit" class="btn btn-dark btn-lg mx-auto action-btn" data-disable-with="Login">Login <i class="fas fa-sign-in-alt"></i></button>
          </div> <br/>
          <%= render "devise/shared/links" %>
        <% end %>
      </div>
    <% end %>
  </div>
  <% if Rails.env.development? %>
    <section class="dev-only" style="background-color: white; color: black; width: 30%; padding: 20px; margin-left: 20px; border-radius: 8px;">
      <h3>Development-only Users</h3>
      <p>These users are only available after running <code>rails db:seed</code> locally:</p>
      <ul>
        <li>Admin User: admin@ucmail.uc.edu</li>
        <li>Owner User: owner@ucmail.uc.edu</li>
        <li>Viewer User: viewer@ucmail.uc.edu</li>
        <li>Manager User: manager@ucmail.uc.edu</li>
      </ul>
      <p>Enter any listed email to sign in locally in development. These accounts are intended for testing and development purposes only and should not be used in production environments.</p>
    </section>
  <% end %>
</div>
