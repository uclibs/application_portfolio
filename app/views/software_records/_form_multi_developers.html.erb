<!-- Multiple Developers -->
<% if current_user.role.to_s != "owner" %>
  <div class="mb-3" id="multiple_developers" data-controller="multi-value-inputs" data-multi-value-inputs-field-name-value="developers">
    <div class="d-flex align-items-center gap-2">
      <%= form.label :developers, "Developers", for: "software_record_developers_1", class: "form-label mb-0" %>
      <button type="button" class="btn btn-sm btn-outline-primary js-add-multivalue" data-action="click->multi-value-inputs#add">+ add more</button>
    </div>

    <% if component.to_s == "new" || @software_record.developers.blank? %>
      <div class="input-group mt-2" data-multivalue-row>
        <%= text_field_tag "software_record[developers][]", nil, required: true, class: "form-control", id: "software_record_developers_1" %>
        <button type="button" class="btn btn-outline-danger js-remove-multivalue" data-action="click->multi-value-inputs#remove">Delete</button>
      </div>
    <% else %>
      <% @software_record.developers.each_with_index do |developer, index| %>
        <% i = index + 1 %>
        <div class="input-group mt-2" data-multivalue-row>
          <%= text_field_tag "software_record[developers][]", developer, required: true, class: "form-control", id: "software_record_developers_#{i}" %>
          <button type="button" class="btn btn-outline-danger js-remove-multivalue" data-action="click->multi-value-inputs#remove">Delete</button>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <% if @software_record.developers.any? %>
    <div class="mb-3" id="multiple_developers">
      <% @software_record.developers.each_with_index do |developer, index| %>
        <% i = index + 1 %>
        <div class="input-group mt-2" style="display: none;" data-multivalue-row>
          <%= text_field_tag "software_record[developers][]", developer, required: true, class: "form-control", id: "software_record_developers_#{i}" %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
<!-- Multiple Developers ends -->
