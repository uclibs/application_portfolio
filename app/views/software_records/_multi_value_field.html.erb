<%# app/views/software_records/_multi_value_field.html.erb %>
<%# locals:
  - form: form builder (optional; used for label)
  - field: Symbol/String (e.g. :product_owners)
  - label: String
  - values: Array (e.g. @software_record.product_owners)
  - required: true/false (default true)
%>

<% field = field.to_s %>
<% values = Array(values).reject(&:blank?) %>
<% required = local_assigns.fetch(:required, true) %>

<div class="mb-3" id="multiple_<%= field %>">
  <div class="d-flex justify-content-between align-items-center">
    <% if local_assigns[:form].present? %>
      <%= form.label field, label, for: "software_record_#{field}_1", class: "form-label mb-0" %>
    <% else %>
      <label for="software_record_<%= field %>_1" class="form-label mb-0"><%= label %></label>
    <% end %>

    <button
      type="button"
      class="btn btn-sm btn-outline-primary js-add-multivalue"
      data-field-name="<%= field %>">
      + add more
    </button>
  </div>

  <% if values.any? %>
    <% values.each_with_index do |val, idx| %>
      <% i = idx + 1 %>
      <div class="input-group mt-2" data-multivalue-row>
        <%= text_field_tag "software_record[#{field}][]",
                           val,
                           required: required,
                           class: "form-control",
                           id: "software_record_#{field}_#{i}" %>

        <button type="button" class="btn btn-outline-danger js-remove-multivalue">
          Delete
        </button>
      </div>
    <% end %>
  <% else %>
    <div class="input-group mt-2" data-multivalue-row>
      <%= text_field_tag "software_record[#{field}][]",
                         nil,
                         required: required,
                         class: "form-control",
                         id: "software_record_#{field}_1" %>

      <button type="button" class="btn btn-outline-danger js-remove-multivalue">
        Delete
      </button>
    </div>
  <% end %>
</div>