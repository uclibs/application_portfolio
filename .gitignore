# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore the default SQLite database.
db/*.sqlite3
db/*.sqlite3-journal
db/*.sqlite3-wal
db/*.sqlite3-shm

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

/tmp/puma/*
!/tmp/puma/
!/tmp/puma/.keep

# Ignore uploaded files in development
/storage/*
!/storage/.keep

/node_modules
/yarn-error.log

/public/assets
.byebug_history

# Add vendor/bundle to ignore tracking history of gems
/vendor/bundle

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore coverage folder
/coverage

# Ignore yarn.lock auto-generated file
yarn.lock

# Ignore .DS_Store files generated in MAC OS
.DS_Store

# Ignore all CSV files generated by export feature
/public/*.csv

# Ignore IDE/editor local configuration
.idea/
.vscode/
.fleet/
# Node version is pinned in .nvmrc (nvm); ignore tool-generated .node-version
.node-version
# Cursor: ignore local IDE state, track shared project rules
.cursor/*
!.cursor/rules/
!.cursor/rules/**
*.sublime-project
*.sublime-workspace

# Ignore .env.production and .env.production.local
.env.production
.env.production.local

/app/assets/builds/*
!/app/assets/builds/.keep
